{
  "name": "@vnxsi/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply vnxsi --local",
    "db:migrate:remote": "wrangler d1 migrations apply vnxsi --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "~5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  }
}
