{
  // vnxsi-web: Hono app + static assets on one Worker (ADR-001).
  "name": "vnxsi-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request reaches Hono first; unmatched paths fall back to ASSETS (app.notFound).
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vnxsi",
      "database_id": "40caf091-7723-4278-9f46-c07069440e73",
      "migrations_dir": "migrations"
    }
  ],
  // Product images (spec §8.5) live in R2. VNX-0711: the Owner created the bucket vnxsi-media, so the binding is on.
  // The code still treats MEDIA as optional: without it, /media/* is 404 and image upload/delete answer 503 with a notice.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vnxsi-media" }],
  "vars": {
    // Used to build absolute links in emails.
    "APP_ORIGIN": "https://vnx.si",
    // Turnstile site key (public) of the vnx.si widget (Owner, 2026-10-04; VNX-0710). Empty = signed-out inquiries and
    // contact messages are refused (fail closed). The secret goes in: wrangler secret put TURNSTILE_SECRET
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFNhEcGnR8e56X8X"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "vnx.si", "custom_domain": true },
    { "pattern": "www.vnx.si", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Daily clean-up runs at 01:00 UTC (src/jobs/daily.ts); the hourly public_stats snapshot runs at minute 05 (src/jobs/hourly.ts).
  // Both triggers are registered on the next `npm run deploy`.
  "triggers": { "crons": ["0 1 * * *", "5 * * * *"] }
  // Secrets (wrangler secret put …): TURNSTILE_SECRET, RESEND_API_KEY, ADMIN_EMAILS, ANALYTICS_SALT.
  // Optional var: MAIL_FROM (default "VNX.SI <noreply@vnx.si>").
  //
  // Deploy order for the routes added in feat/m0-m1-foundation (/login, /auth/verify, /logout):
  //   0. wrangler r2 bucket create vnxsi-media      (once)
  //   1. npm run db:migrate:remote -w apps/web      (applies 0003_identity, 0004_builders, 0005_products, 0006_catalog, 0007_inquiries, 0008_requests, 0009_feedback, 0010_feature_flags, 0011_partners, 0012_outbound_clicks, 0014_product_stats, 0016_public_stats)
  //   2. wrangler secret put ADMIN_EMAILS
  //      wrangler secret put RESEND_API_KEY         (the Resend sending domain must be verified)
  //   3. npm run deploy
  // 0006_catalog (M4) and the M4 code ship together: run the migration and `npm run deploy` back to back. Once 0006
  // is applied, pre-M4 code (D1 meta.changes === 1) returns 409 on every edit of a published product (FTS triggers add changes).
  // 0007_inquiries (M5) and the M5 code ship together too: the M5 code needs 0007 before it can serve /hub and /me, so
  // migrate first, then deploy. The daily cron trigger ("0 1 * * *") takes effect on deploy; it also reads the 0007 tables.
  // 0008_requests (M6) ships with the M6 code the same way: migrate first, then deploy (the daily cron reads 0008 too).
  // 0010_feature_flags, 0011_partners and 0012_outbound_clicks (EPIC 21) ship with their code the same way: migrate first, then deploy.
  // 0014_product_stats (M7) ships with its code the same way: migrate first, then deploy. 0013 is Ops O1 (ops_members).
  // 0016_public_stats (M7, hourly snapshot table) ships the same way.
  // The daily cron also deletes outbound clicks older than 13 months, so it reads 0012 too.
  // Until this order is followed, deploying main also publishes /login and /auth/verify,
  // which will fail (missing tables / missing mail credentials).
  //
  // MAIL_DRIVER selects the mailer. Local dev: set MAIL_DRIVER=console in apps/web/.dev.vars.
  // Tests use "fake". Production leaves it unset and sends through RESEND_API_KEY.
  //
  // ANALYTICS_SALT (M7): `wrangler secret put ANALYTICS_SALT` with a random value of 32+ characters (e.g. `openssl rand -hex 32`). Local dev:
  // add ANALYTICS_SALT=<any random string> to apps/web/.dev.vars (git-ignored). Never put it in "vars". While it is unset the Worker counts
  // no views or clicks and sets no visitor cookie. Rotating it only restarts de-duplication for that day.
  // ANALYTICS_SALT is the production on-switch for counting: do NOT set it in production until Task 3 and the Privacy update go live (until
  // then each isolate logs visitor.no_salt once, which is expected).
}
